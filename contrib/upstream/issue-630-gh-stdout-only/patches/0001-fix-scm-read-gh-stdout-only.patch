+// gh pr create prints the new PR URL on stdout and nothing else that matters,
+// so a wrapper's stderr notice must stay out of pr.URL: every later command
+// targets the PR by that URL, and a notice-prefixed one never existed. See #630.
+func TestCreatePRKeepsURLOutOfWrapperStderrNotice(t *testing.T) {
+	t.Parallel()
+
+	host := New(githubTestCmdFactory(map[string]githubTestResponse{
+		"gh pr create --head feature/wrapper --base main --repo test/repo --title fix: url --body-file -": {
+			stderr:    "automic vault: human approval required\n",
+			stdout:    "https://github.com/test/repo/pull/43\n",
+			wantStdin: "## What Changed\n\n- keep the URL out of wrapper noise",
+		},
+	}), nil, "", "test/repo")
+
+	pr, err := host.CreatePR(context.Background(), "feature/wrapper", "main", scm.PRContent{
+		Title: "fix: url",
+		Body:  "## What Changed\n\n- keep the URL out of wrapper noise",
+	})
+	if err != nil {
+		t.Fatalf("CreatePR() error = %v", err)
+	}
+	if pr == nil || pr.Number != "43" {
+		t.Fatalf("CreatePR() PR = %+v, want #43", pr)
+	}
+	if pr.URL != "https://github.com/test/repo/pull/43" {
+		t.Fatalf("CreatePR() URL = %q, want exactly the URL gh printed on stdout", pr.URL)
+	}
+}
