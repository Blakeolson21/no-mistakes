+// The repository lookup behind an attachment upload is a data-bearing gh read
+// like every other one, so a wrapper's stderr notice must not turn a WRITE
+// permission lookup into a parse failure. See #630.
+func TestUserAssetRepoIgnoresWrapperStderrNotice(t *testing.T) {
+	t.Parallel()
+	host := New(githubTestCmdFactory(map[string]githubTestResponse{
+		"gh api --hostname github.com graphql -f query=" + userAssetRepoQuery + " -F owner=test -F name=repo": {
+			stderr: "automic vault: human approval required\n",
+			stdout: `{"data":{"repository":{"databaseId":42,"viewerPermission":"WRITE"}}}`,
+		},
+	}), nil, "github.com", "test/repo")
+
+	id, permission, err := host.userAssetRepo(context.Background())
+	if err != nil {
+		t.Fatalf("userAssetRepo() error = %v", err)
+	}
