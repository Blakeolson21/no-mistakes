+// The CI step polls this on a loop, so a wrapper's stderr notice on an
+// otherwise successful `gh pr checks` used to fail every parse for the whole
+// poll window regardless of what CI actually reported. See #630.
+func TestGetChecksIgnoresWrapperStderrNotice(t *testing.T) {
+	t.Parallel()
+
+	host := New(githubTestCmdFactory(map[string]githubTestResponse{
+		"gh pr checks 123 --repo test/repo --json name,state,bucket,completedAt,link": {
+			stderr: "automic vault: human approval required\n",
+			stdout: `[{"name":"build","state":"SUCCESS","bucket":"pass"}]` + "\n",
+		},
+	}), nil, "", "test/repo")
+
+	checks, err := host.GetChecks(context.Background(), &scm.PR{Number: "123"})
+	if err != nil {
+		t.Fatalf("GetChecks() error = %v", err)
+	}
+	if len(checks) != 1 || checks[0].Name != "build" || checks[0].Bucket != scm.CheckBucketPass {
+		t.Fatalf("checks = %+v, want the single build check gh reported on stdout", checks)
+	}
+}
+
+// `gh pr checks` reports an empty rollup as a non-zero exit with the notice on
+// stderr, so that message has to stay readable now that stdout is isolated.
+// See #630.
+func TestGetChecksKeepsNoChecksReportedOnStderr(t *testing.T) {
+	t.Parallel()
+
+	host := New(githubTestCmdFactory(map[string]githubTestResponse{
+		"gh pr checks 123 --repo test/repo --json name,state,bucket,completedAt,link": {
+			stderr: "no checks reported on the 'feature' branch\n",
+			code:   1,
+		},
+	}), nil, "", "test/repo")
+
+	checks, err := host.GetChecks(context.Background(), &scm.PR{Number: "123"})
+	if err != nil {
+		t.Fatalf("GetChecks() error = %v", err)
+	}
+	if len(checks) != 0 {
+		t.Fatalf("checks = %+v, want none", checks)
+	}
+}
+
+// The head-commit path reads two more gh payloads - the GraphQL check rollup and
+// the Actions run list - so a wrapper's stderr notice must not corrupt either.
+// See #630.
+func TestGetChecksReadsCommitRollupAndRunsDespiteWrapperStderrNotice(t *testing.T) {
+	t.Parallel()
+
+	host := New(githubTestCmdFactory(map[string]githubTestResponse{
+		"gh pr view 123 --repo test/repo --json headRefOid --jq .headRefOid": {
+			stderr: "automic vault: human approval required\n",
+			stdout: "deadbeef\n",
+		},
+		githubCommitChecksCommand("", "test/repo", "deadbeef"): {
+			stderr: "automic vault: human approval required\n",
+			stdout: githubCommitChecksResponse(`[{"__typename":"CheckRun","databaseId":9,"name":"clippy","status":"COMPLETED","conclusion":"SUCCESS","completedAt":"2026-08-01T10:00:00Z","detailsUrl":"https://github.com/test/repo/actions/runs/7/job/9","checkSuite":{"app":{"slug":"github-actions"}}}]`),
+		},
+		"gh api --method GET repos/test/repo/actions/runs -f head_sha=deadbeef -f per_page=100 --paginate --slurp": {
+			stderr: "automic vault: human approval required\n",
+			stdout: `[{"total_count":1,"workflow_runs":[
+				{"id":101,"name":"ci","display_title":"","status":"completed","conclusion":"failure","updated_at":"2026-08-01T11:00:00Z"}
+			]}]` + "\n",
+		},
+	}), nil, "", "test/repo")
+
+	checks, err := host.GetChecks(context.Background(), &scm.PR{Number: "123", HeadSHA: "deadbeef"})
+	if err != nil {
+		t.Fatalf("GetChecks() error = %v", err)
+	}
+	if len(checks) != 2 {
+		t.Fatalf("GetChecks() returned %d checks, want 2: %+v", len(checks), checks)
+	}
+	if got := checks[0]; got.Name != "clippy" || got.Bucket != scm.CheckBucketPass {
+		t.Fatalf("rollup check = %+v, want clippy/pass", got)
+	}
+	if got := checks[1]; got.Name != "ci" || got.Bucket != scm.CheckBucketFail {
+		t.Fatalf("workflow run check = %+v, want ci/fail", got)
+	}
+}
