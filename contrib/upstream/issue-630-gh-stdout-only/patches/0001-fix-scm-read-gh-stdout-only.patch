+// A gh wrapper can print an audit notice to stderr on every invocation and
+// still exit 0 (an approval gate, an SSO helper, a corporate proxy). The notice
+// is not part of the payload, so the listing JSON on stdout stays parseable and
+// the branch's existing PR is still found. See #630.
+func TestFindPRIgnoresWrapperStderrNotice(t *testing.T) {
+	t.Parallel()
+
+	host := New(githubTestCmdFactory(map[string]githubTestResponse{
+		"gh pr list --head feature/wrapper --base main --repo test/repo --state open --json number,url,baseRefName": {
+			stderr: "automic vault: human approval required\n",
+			stdout: `[{"number":42,"url":"https://github.com/test/repo/pull/42","baseRefName":"main"}]` + "\n",
+		},
+	}), nil, "", "test/repo")
+
+	pr, err := host.FindPR(context.Background(), "feature/wrapper", "main")
+	if err != nil {
+		t.Fatalf("FindPR() error = %v", err)
+	}
+	if pr == nil || pr.Number != "42" {
+		t.Fatalf("FindPR() PR = %+v, want #42", pr)
+	}
+	if pr.URL != "https://github.com/test/repo/pull/42" {
+		t.Fatalf("FindPR() URL = %q, want the URL gh printed on stdout", pr.URL)
+	}
+}
