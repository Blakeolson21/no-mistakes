+// ghOutput runs a gh invocation and returns its stdout ALONE, plus a
+// human-readable detail string for error messages.
+//
+// Every data-bearing gh call in this provider parses stdout (or takes the
+// created PR URL from it), but gh is not necessarily the process that runs: a
+// wrapper around it - an approval gate, an SSO helper, a corporate proxy - may
+// print its own notice to stderr and still exit 0, because the notice is not a
+// refusal. Reading CombinedOutput merged that notice into the payload, so the
+// listing and rollup JSON failed to parse on bytes gh never wrote, `gh pr
+// create`'s URL carried the notice, and the CI step's poll loop could not parse
+// a single response no matter what CI reported.
+//
+// Stderr stays diagnostics, and it is what a failure quotes - including gh's own
+// "no checks reported", which gh writes to stderr with a non-zero exit.
+// Invocations that only ever use the bytes to build an error message
+// (UpdatePR, SetPRBaseBranch, RerunCheck) keep CombinedOutput: merging is
+// correct when the bytes are never parsed. See #630.
+func ghOutput(cmd *exec.Cmd) ([]byte, string, error) {
+	out, err := cmd.Output()
+	detail := strings.TrimSpace(string(out))
+	var exitErr *exec.ExitError
+	if errors.As(err, &exitErr) {
+		// ExitError.Stderr is only populated when the caller left cmd.Stderr
+		// nil, which every data-bearing gh call here does.
+		if stderr := strings.TrimSpace(string(exitErr.Stderr)); stderr != "" {
+			detail = stderr
+		}
+	}
+	return out, detail, err
+}
